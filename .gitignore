# Secrets (jamais en clair dans le dépôt)
.env
.env.*
!.env.example
*.pem
*.key
*.crt
*.p12
age-keys.txt
*.keys.txt
infra/secrets/*
!infra/secrets/.gitkeep
!infra/secrets/*.enc.*
vault-data/
.vault-token

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.ruff_cache/
.mypy_cache/
.coverage
htmlcov/
*.egg-info/

# Node / front
node_modules/
dist/
build/
.vite/

# ML (modèles et données volumineuses régénérables)
ml/models/*
!ml/models/.gitkeep
ml/data/*.csv
!ml/data/normal.csv
!ml/data/holdout.csv
!ml/data/attack.csv
ml/data/*.parquet
.ipynb_checkpoints/

# Docker / données locales
*.log
/data/
volumes/

# Ansible
*.retry

# Outillage des agents (voir docs/dev.md)
# Réglages personnels : .claude/settings.json et .mcp.json, eux, sont versionnés.
.claude/settings.local.json
# Worktrees créés pour les agents : des copies de travail, jamais du contenu à versionner.
.claude/worktrees/
# rtk : données dans ~/.rtk, config dans ~/.config/rtk. Ne restent ici que des
# réglages locaux et le marqueur d'intégrité du hook. Un .rtk/filters.toml
# destiné à toute l'équipe se versionne avec `git add -f`.
.rtk/
.rtk-hook.sha256
.claude/hooks/rtk-rewrite.sh

# IDE / OS
.idea/
.vscode/
.DS_Store
Thumbs.db

# Livrables générés
*.zip
*.mp4

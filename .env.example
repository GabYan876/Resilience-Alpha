# Modèle de configuration — PROJECT RESILIENCE-ALPHA
#
# Copier en `.env` (ignoré par Git) puis renseigner les valeurs via Vault/SOPS.
# Ce fichier ne contient QUE des valeurs d'exemple : aucun secret réel ici,
# ni dans le dépôt, ni dans les images, ni dans l'archive de rendu.
# Les mots de passe sont utilisés dans des URL de connexion : s'en tenir à
# [A-Za-z0-9_-] évite d'avoir à les encoder.

# --- PostgreSQL (socle de données) ---------------------------------------
# Rôle propriétaire : seul habilité au DDL (migrations Alembic).
POSTGRES_DB=resilience
POSTGRES_USER=resilience_owner
POSTGRES_PASSWORD=remplacer-par-un-secret-genere

# Rôle applicatif de l'API : SELECT / INSERT / UPDATE, aucun DDL, aucun DELETE.
APP_RW_PASSWORD=remplacer-par-un-secret-genere
# Rôle en lecture seule destiné à l'assistant RAG : SELECT uniquement.
APP_RO_PASSWORD=remplacer-par-un-secret-genere

# --- API métier -----------------------------------------------------------
# Jeton partagé avec la sonde de transaction du moteur de remédiation
# (variable PROBE_TOKEN du service `remediation`). Vide = garde désactivée,
# à réserver au développement local.
PROBE_TOKEN=remplacer-par-un-jeton-genere
# Compte de sonde rechargé par scripts/reset_demo.sh (probe@resilience.local).
PROBE_ACCOUNT_IBAN=TEST-0001
# Solde remis à la sonde à chaque reset, en centimes (1 000 000 = 10 000,00 €).
PROBE_BALANCE_CENTS=1000000
# Taille du pool de connexions SQLAlchemy (conteneur limité à 256 Mo).
DB_POOL_SIZE=5
# 1 = journaliser le SQL émis (débogage uniquement, verbeux).
SQL_ECHO=0

# --- Jeu de données de démonstration -------------------------------------
# Mot de passe fictif haché en argon2 pour tous les comptes du seed.
# Données 100 % fictives : aucun identifiant réel.
SEED_PASSWORD=demo-only-not-a-secret

# --- Observabilité (infra/compose/docker-compose.observability.yml) -------
# Mot de passe admin Grafana : OBLIGATOIRE, la pile refuse de démarrer sans.
GRAFANA_ADMIN_PASSWORD=remplacer-par-un-secret-genere
GRAFANA_ADMIN_USER=admin
# Accès anonyme en lecture : true pour la démonstration (clip), false sinon.
GRAFANA_ANONYMOUS_ENABLED=true
# Endpoint Docker d'Alloy : la passerelle en lecture seule, jamais le socket.
ALLOY_DOCKER_HOST=tcp://docker-proxy:2375

# --- Moteur de remédiation (services/remediation) -------------------------
# Jeton exigé par POST /incidents (appelé par le détecteur ML) : OBLIGATOIRE,
# le service ne démarre pas sans lui.
REMEDIATION_INGEST_TOKEN=remplacer-par-un-jeton-genere
# API métier ciblée par la sonde de transaction ; PROBE_TOKEN (ci-dessus) est réutilisé.
API_BASE_URL=http://api:8000
# Passerelle Docker du moteur (redémarrage uniquement), jamais docker.sock.
DOCKER_PROXY_URL=http://docker-proxy:2375
# Service Compose -> container_name réel, au format service=conteneur,... (défaut api=resilience-api).
CONTAINER_NAMES=api=resilience-api

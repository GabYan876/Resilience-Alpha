# Modèle de configuration — PROJECT RESILIENCE-ALPHA
#
# Copier en `.env` (ignoré par Git) puis renseigner les valeurs via Vault/SOPS.
# Ce fichier ne contient QUE des valeurs d'exemple : aucun secret réel ici,
# ni dans le dépôt, ni dans les images, ni dans l'archive de rendu.
# Les mots de passe sont utilisés dans des URL de connexion : s'en tenir à
# [A-Za-z0-9_-] évite d'avoir à les encoder.

# --- PostgreSQL (socle de données) ---------------------------------------
# Rôle propriétaire : seul habilité au DDL (migrations Alembic).
POSTGRES_DB=resilience
POSTGRES_USER=resilience_owner
POSTGRES_PASSWORD=remplacer-par-un-secret-genere

# Rôle applicatif de l'API : SELECT / INSERT / UPDATE, aucun DDL, aucun DELETE.
APP_RW_PASSWORD=remplacer-par-un-secret-genere
# Rôle en lecture seule destiné à l'assistant RAG : SELECT uniquement.
APP_RO_PASSWORD=remplacer-par-un-secret-genere

# --- API métier -----------------------------------------------------------
# Jeton partagé avec la sonde de transaction et le service privé de restauration.
# Obligatoire dans Compose : protège les transactions de sonde et les opérations S4.
PROBE_TOKEN=remplacer-par-un-jeton-genere
# Compte de sonde rechargé par scripts/reset_demo.sh (probe@resilience.local).
PROBE_ACCOUNT_IBAN=TEST-0001
# Solde remis à la sonde à chaque reset, en centimes (1 000 000 = 10 000,00 €).
PROBE_BALANCE_CENTS=1000000
# Taille du pool de connexions SQLAlchemy (conteneur limité à 256 Mo).
DB_POOL_SIZE=5
# 1 = journaliser le SQL émis (débogage uniquement, verbeux).
SQL_ECHO=0

# --- Authentification (services/auth) et passerelle ------------------------
# Secret de signature des jetons JWT (HS256), partagé par `auth` (émission) et `api`
# (vérification) : OBLIGATOIRE, 32 caractères minimum, aucune valeur par défaut.
# Générer : python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=remplacer-par-un-secret-genere-de-32-caracteres-minimum
# Durée de vie d'un jeton, en secondes (7200 = 2 h).
JWT_TTL_SECONDS=7200
# Solde fictif crédité à l'inscription, en centimes (100000 = 1 000,00 €).
WELCOME_BALANCE_CENTS=100000

# --- Jeu de données de démonstration -------------------------------------
# Mot de passe fictif haché en argon2 pour tous les comptes du seed.
# Données 100 % fictives : aucun identifiant réel.
SEED_PASSWORD=demo-only-not-a-secret

# --- Observabilité (infra/compose/docker-compose.observability.yml) -------
# Mot de passe admin Grafana : OBLIGATOIRE, la pile refuse de démarrer sans.
GRAFANA_ADMIN_PASSWORD=remplacer-par-un-secret-genere
GRAFANA_ADMIN_USER=admin
# Accès anonyme en lecture : true pour la démonstration (clip), false sinon.
GRAFANA_ANONYMOUS_ENABLED=true
# Endpoint Docker d'Alloy : la passerelle en lecture seule, jamais le socket.
ALLOY_DOCKER_HOST=tcp://docker-proxy:2375

# --- Moteur de remédiation (services/remediation) -------------------------
# Jeton exigé par POST /incidents (appelé par le détecteur ML) : OBLIGATOIRE,
# le service ne démarre pas sans lui.
REMEDIATION_INGEST_TOKEN=remplacer-par-un-jeton-genere
# API métier ciblée par la sonde de transaction ; PROBE_TOKEN (ci-dessus) est réutilisé.
API_BASE_URL=http://api:8000
# Passerelle Docker du moteur (redémarrage uniquement), jamais docker.sock.
DOCKER_PROXY_URL=http://docker-proxy-ctl:2375
# Service Compose -> container_name réel, au format service=conteneur,... (défaut api=resilience-api).
CONTAINER_NAMES=api=resilience-api
# Délai (s) de la requête de redémarrage Docker : Docker laisse 10 s au conteneur pour s'arrêter.
RESTART_TIMEOUT_S=30
# Temps (s) laissé à l'API pour redevenir saine après un redémarrage, avant de conclure à l'échec.
# Le détecteur qui appelle POST /incidents doit attendre au moins cette durée par tentative.
VERIFY_WAIT_S=30
# Détection de crash (scénario S3) : le moteur sonde GET /health de l'API toutes les
# WATCH_INTERVAL_S secondes (0 = désactivé) et relance le conteneur après WATCH_FAILURES échecs
# consécutifs. Délai de détection = WATCH_INTERVAL_S x WATCH_FAILURES.
WATCH_INTERVAL_S=5
WATCH_FAILURES=3

# --- Sauvegarde/restauration PostgreSQL (scénario S4) ----------------------
# Sauvegarde custom-format immédiatement au démarrage puis toutes les 5 min.
# Cible RPO provisoire : au plus 5 min ; les 12 dernières archives sont conservées.
DB_BACKUP_INTERVAL_S=300
DB_BACKUP_RETENTION=12
# Marge retirée de l'heure de détection : la restauration ignore les archives plus récentes
# (la corruption précède la détection ; une archive récente peut déjà être altérée).
DB_RESTORE_SAFETY_MARGIN_S=60

# --- Détecteur ML (services/anomaly-detector) -----------------------------
# Valeurs par défaut du Compose, ajustables. Il réutilise REMEDIATION_INGEST_TOKEN.
# Service surveillé (nom du label `service` dans Prometheus).
DETECTOR_TARGET_SERVICE=api
# Intervalle (s) entre deux mesures.
DETECTOR_POLL_INTERVAL_S=5
# Mesures anormales consécutives avant de signaler : délai minimal de détection =
# DETECTOR_CONFIRMATIONS x DETECTOR_POLL_INTERVAL_S.
DETECTOR_CONFIRMATIONS=3
# Silence (s) après un signalement, le temps de la remédiation : doit rester supérieur à
# VERIFY_WAIT_S, sinon le détecteur re-signale pendant la vérification.
DETECTOR_COOLDOWN_S=90

# --- Assistant RAG (services/rag-assistant) -------------------------------
# Jeton exigé par POST /ask et POST /reindex : OBLIGATOIRE (le CLI du conteneur le lit seul).
RAG_TOKEN=remplacer-par-un-jeton-genere
# Ollama n'est PAS dans le Compose (RAM). Par défaut : le PC hôte, avec OLLAMA_HOST=172.17.0.1:11434
# (IP de docker0 : jamais 0.0.0.0, Ollama n'a pas d'authentification). Si l'hôte a moins de 32 Go,
# pointer vers le 3e PC, ex. http://192.168.137.20:11434, avec un pare-feu qui n'accepte que
# 192.168.137.1 (jamais un autre réseau que le hotspot du consortium).
OLLAMA_URL=http://host.docker.internal:11434
# Modèle de langage (contrainte du sujet : <= 8 milliards de paramètres) et modèle d'embeddings.
# À télécharger côté Ollama : `ollama pull llama3.1:8b` puis `ollama pull nomic-embed-text`.
RAG_LLM_MODEL=llama3.1:8b
RAG_EMBED_MODEL=nomic-embed-text

# --- WAF (ModSecurity + OWASP CRS) ----------------------------------------
# Niveau de paranoïa 1 à 4 : plus haut = plus de détections, plus de faux positifs.
WAF_PARANOIA=1
# Score d'anomalie entrant à partir duquel la requête est bloquée (403).
WAF_ANOMALY_INBOUND=5

# --- Identification de l'attaquant (détecteur ML) --------------------------
# Un compte n'est désigné que s'il émet au moins ce nombre de requêtes sur la fenêtre
# ET au moins cette part du trafic authentifié : évite de bloquer un utilisateur légitime.
ATTACKER_WINDOW=30s
ATTACKER_MIN_REQUESTS=100
ATTACKER_MIN_SHARE=0.5

# Point d'entrée unique (préfigure le WAF) : sert le front React et route /auth et /me.
# Écoute sur 8080 (port non privilégié) ; seule NET_BIND_SERVICE est conservée (voir compose).
# Non publié : le WAF est le seul point d'entrée.
{
	admin off
	auto_https off
}

:8080 {
	encode gzip

	# Corps limité : aucune route ne reçoit plus que quelques champs JSON.
	request_body {
		max_size 16KB
	}

	# Grafana pose sa propre politique (scripts inline, eval) : notre CSP stricte la casserait.
	@notgrafana not path /grafana /grafana/*

	header {
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy no-referrer
		-Server
	}
	header @notgrafana Content-Security-Policy "default-src 'self'; img-src 'self' data:; style-src 'self' 'unsafe-inline'; frame-ancestors 'none'"

	# Authentification -> services/auth
	handle /auth/* {
		# lb_try_duration : une requête attend jusqu'à 6 s un service en cours de redémarrage
		# (remédiation) au lieu d'échouer aussitôt.
		reverse_proxy auth:8000 {
			lb_try_duration 6s
		}
	}

	# Espace client -> services/api. Ni /metrics, ni /health, ni /transactions (sonde) ne
	# sont exposés : ils restent sur le réseau interne.
	handle /me/* {
		reverse_proxy api:8000 {
			lb_try_duration 6s
		}
	}

	# Supervision : Grafana (dashboard ouvert par défaut) servi sous /grafana, derrière le WAF.
	# Grafana tourne avec GF_SERVER_SERVE_FROM_SUB_PATH=true : le préfixe est conservé.
	handle /grafana* {
		reverse_proxy grafana:3000 {
			lb_try_duration 6s
		}
	}

	# Tout le reste = front React (SPA)
	handle {
		root * /srv
		try_files {path} /index.html
		file_server
	}
}

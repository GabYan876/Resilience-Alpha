      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "green"
          },
          "noValue": "0",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Trafic du WAF par statut HTTP",
      "description": "Le flood fait monter le débit ; le blocage de la source fait basculer les 200 en 403.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum by (status) (rate({service=\"waf\"} | json [30s]))",
          "legendFormat": "{{status}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "stacking": {
              "mode": "normal"
            }
          },
          "noValue": "aucune donnée"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 6,
      "type": "timeseries",
      "title": "Trafic par compte (5 premiers)",
      "description": "Un compte qui se détache nettement est celui que le détecteur désigne comme source de l'attaque.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 4,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(5, sum by (sub) (rate({service=\"waf\"} | json | sub != \"\" [30s])))",
          "legendFormat": "{{sub}}",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "stacking": {
              "mode": "none"
            }
          },
          "noValue": "aucune donnée"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 7,
      "type": "timeseries",
      "title": "Attaques bloquées par famille de règles CRS",
      "description": "941 = XSS, 942 = injection SQL, 930/931 = traversée de chemin / inclusion de fichier, 932/933 = exécution de code, 913 = scanner.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({container=\"resilience-waf\"} |= \"\\\"is_interrupted\\\":true\" |~ \"\\\"ruleId\\\":\\\"942\" [30s]))",
          "legendFormat": "Injection SQL",
          "queryType": "range"
        },
        {
          "refId": "B",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({container=\"resilience-waf\"} |= \"\\\"is_interrupted\\\":true\" |~ \"\\\"ruleId\\\":\\\"941\" [30s]))",
          "legendFormat": "XSS",
          "queryType": "range"
        },
        {
          "refId": "C",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({container=\"resilience-waf\"} |= \"\\\"is_interrupted\\\":true\" |~ \"\\\"ruleId\\\":\\\"93[01]\" [30s]))",
          "legendFormat": "Traversée / inclusion",
          "queryType": "range"
        },
        {
          "refId": "D",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({container=\"resilience-waf\"} |= \"\\\"is_interrupted\\\":true\" |~ \"\\\"ruleId\\\":\\\"93[23]\" [30s]))",
          "legendFormat": "Exécution de code",
          "queryType": "range"
        },
        {
          "refId": "E",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({container=\"resilience-waf\"} |= \"\\\"is_interrupted\\\":true\" |~ \"\\\"ruleId\\\":\\\"913\" [30s]))",
          "legendFormat": "Scanner",
          "queryType": "range"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "lineWidth": 2,
            "fillOpacity": 15,
            "stacking": {
              "mode": "normal"
            }
          },
          "noValue": "aucune donnée"
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom"
        },
        "tooltip": {
          "mode": "multi"
        }
      }
    },
    {
      "id": 8,
      "type": "table",
      "title": "Comptes les plus actifs sur la période",
      "description": "Requêtes authentifiées par compte (sub du JWT) sur la période affichée.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 12,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "topk(10, sum by (sub) (count_over_time({service=\"waf\"} | json | sub != \"\" [$__range])))",
          "legendFormat": "",
          "queryType": "instant",
          "instant": true,
          "format": "table"
        }
      ],
      "transformations": [
        {
          "id": "organize",
          "options": {
            "excludeByName": {
              "Time": true
            },
            "renameByName": {
              "sub": "Compte (sub)",
              "Value": "Requêtes"
            }
          }
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "sortBy": [
          {
            "displayName": "Requêtes",
            "desc": true
          }
        ]
      }
    },
    {
      "id": 9,
      "type": "logs",
      "title": "Requêtes bloquées par les règles (détail)",
      "description": "URI et code de réponse des requêtes interrompues par le WAF.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{container=\"resilience-waf\"} |= \"\\\"is_interrupted\\\":true\" | json uri=\"transaction.request.uri\", code=\"transaction.response.http_code\" | line_format \"{{.code}}  {{.uri}}\"",
          "legendFormat": "",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    },
    {
      "id": 10,
      "type": "logs",
      "title": "Réponse automatisée : actions de blocage du moteur",
      "description": "Événements action.executed des actions block_ip / block_subject, avec trace_id pour corréler avec l'incident.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 20,
        "w": 12,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "{service=\"remediation\", event=\"action.executed\"} | json | data_action=~\"block_.*\"",
          "legendFormat": "",
          "queryType": "range"
        }
      ],
      "options": {
        "showTime": true,
        "wrapLogMessage": true,
        "sortOrder": "Descending",
        "enableLogDetails": true
      }
    }
  ]

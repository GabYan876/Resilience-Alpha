{
  "uid": "siem-waf",
  "title": "Resilience-Alpha — SIEM : WAF et réponse automatisée",
  "tags": [
    "resilience-alpha",
    "siem",
    "waf"
  ],
  "timezone": "browser",
  "schemaVersion": 39,
  "version": 1,
  "editable": false,
  "refresh": "10s",
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "description": "Fonction SOC (Loki + Grafana) : ce que le WAF voit et bloque, qui attaque, et ce que le moteur de remédiation fait en réponse.",
  "links": [
    {
      "title": "Incident et reprise automatique",
      "type": "link",
      "url": "/d/resilience-alpha",
      "icon": "dashboard"
    }
  ],
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Requêtes bloquées par les règles (CRS)",
      "description": "Requêtes interrompues par ModSecurity + OWASP CRS : SQLi, XSS, traversée de chemin...",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({container=\"resilience-waf\"} |= \"\\\"is_interrupted\\\":true\" [$__range]))",
          "legendFormat": "",
          "queryType": "instant",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "noValue": "0",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Requêtes bloquées par la liste de sources",
      "description": "403 émis parce que le compte ou l'IP figure dans la liste alimentée par le moteur de remédiation (total des 403 moins les blocages CRS).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service=\"waf\"} | json | status=\"403\" [$__range])) - (sum(count_over_time({container=\"resilience-waf\"} |= \"\\\"is_interrupted\\\":true\" [$__range])) or vector(0))",
          "legendFormat": "",
          "queryType": "instant",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "orange"
          },
          "noValue": "0",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Comptes bloqués par la remédiation",
      "description": "Actions block_subject réussies : preuve que le moteur a désigné et bloqué l'attaquant sans intervention humaine.",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service=\"remediation\", event=\"action.executed\"} | json | data_action=\"block_subject\" | data_success=\"true\" [$__range]))",
          "legendFormat": "",
          "queryType": "instant",
          "instant": true
        }
      ],
      "options": {
        "colorMode": "background",
        "graphMode": "none",
        "textMode": "value",
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        }
      },
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "purple"
          },
          "noValue": "0",
          "decimals": 0
        },
        "overrides": []
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Incidents clos sans intervention",
      "description": "incident.resolved émis par le moteur (API saine ET transaction de test réussie).",
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "loki",
            "uid": "loki"
          },
          "expr": "sum(count_over_time({service=\"remediation\", event=\"incident.resolved\"} [$__range]))",
          "legendFormat": "",
          "queryType": "instant",
          "instant": true
        }
      ],
      "options": {
